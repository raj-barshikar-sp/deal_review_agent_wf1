# Copy to .env and fill in. .env is git-ignored.

# Salesforce REST (client credentials)
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Salesforce screenshot login (JWT bearer). Key goes in certs/sf-jwt.key or SALESFORCE_JWT_KEY_FILE.
SALESFORCE_JWT_CLIENT_ID=
SALESFORCE_USERNAME=

# Asana (personal access token is the simplest option)
ASANA_ACCESS_TOKEN=
