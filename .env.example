# Copy to .env and fill in. .env is git-ignored.

# Salesforce: one app (SF_PROD_ID / SF_PROD_SECRET) for REST and the JWT screenshot login
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SF_PROD_ID=
SF_PROD_SECRET=

# Salesforce screenshot login (JWT bearer). Key goes in certs/sf-jwt.key or SALESFORCE_JWT_KEY_FILE.
SALESFORCE_USERNAME=

# Asana (personal access token is the simplest option)
ASANA_ACCESS_TOKEN=

# SharePoint (Microsoft Graph, app-only). Entra app needs Sites.Selected with write on the Finance site.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE=sailpoint.sharepoint.com/sites/Finance
SHAREPOINT_DRIVE_NAME=Documents
# Live: Order Processing/2024 Invoices   Test: TEST - New Deal Review Agent
SHAREPOINT_ROOT_PATH=TEST - New Deal Review Agent
