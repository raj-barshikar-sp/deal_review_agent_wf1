flowchart TB
    classDef gcp fill:#e8f0fe,stroke:#1a73e8,color:#174ea6
    classDef ext fill:#fff4e5,stroke:#e8710a,color:#8a4600
    classDef data fill:#e6f4ea,stroke:#137333,color:#0d652d
    classDef llm fill:#f3e8fd,stroke:#8430ce,color:#5b1d9c,stroke-dasharray: 5 5
    classDef opt fill:#f1f3f4,stroke:#80868b,color:#3c4043,stroke-dasharray: 5 5

    subgraph TRIG["Triggers"]
        direction LR
        PAUT["Power Automate cloud flow<br/>Shared mailbox trigger to HTTP POST<br/>NEEDS PREMIUM LICENCE"]:::ext
        SCHED["Cloud Scheduler<br/>mail poll every 5 min<br/>ONLY if Graph polling is chosen"]:::opt
        NSHOOK["NetSuite SuiteScript<br/>afterSubmit POST on Sales Order<br/>REQUIRED, no sweep (phase 3)<br/>RA trigger: open question 18"]:::ext
        GWH["API Gateway<br/>per-app OpenAPI spec<br/>API key + HMAC shared secret<br/>exposes /events/* only"]:::gcp
    end

    subgraph CR["Cloud Run service: new-deal-review-agent (no-allow-unauthenticated)"]
        direction TB
        EV["Webhook ingress<br/>/events/mail  /events/netsuite<br/>verify HMAC, read quote number,<br/>enqueue one task, return 202"]:::gcp
        ADV["Worker endpoint<br/>/internal/advance<br/>called only by Cloud Tasks<br/>also /healthz, /deals/{quote}, optional /jobs/poll"]:::gcp
        ORCH["Deterministic orchestrator<br/>find Asana task by quote number<br/>derive missing stages from Asana + SharePoint"]:::gcp
        subgraph STAGES["Stage handlers (idempotent, each re-runnable)"]
            direction LR
            S1["task_created<br/>Asana task upsert"]
            S2["signed_quote_in<br/>executed quote PDF only<br/>CRITICAL PATH"]
            S3["amendment_checked<br/>order type + cancelled-quote subtask"]
            S2B["pack_in_progress<br/>TAF, PO, master agreement<br/>BEST EFFORT"]
            S4["so_enriched<br/>TCV, size, SO/RMA, project codes"]
            S5["ra_ready<br/>RA number"]
            S6["drs_done<br/>DRS workbook build + upload"]
        end
        subgraph AGENT["OPTIONAL: judgment steps, only if an LLM stage is adopted (open question 20)"]
            direction LR
            L1["PA email extractor<br/>default: regex for quote number"]:::llm
            L2["Document classifier<br/>default: Salesforce object + title"]:::llm
            L3["Amendment analyst<br/>default: decide after real samples"]:::llm
            L4["DRS variance narrator<br/>default: templated text"]:::llm
        end
        CONN["Connector layer<br/>retry, backoff, rate limit, audit log"]:::gcp
    end

    subgraph STATE["Queue and secrets (no database)"]
        TASKS["Cloud Tasks queue ndra-advance<br/>one task per event, named from event id<br/>max_concurrent_dispatches = 1<br/>retries with backoff"]:::gcp
        SM[("Secret Manager<br/>Salesforce integration user,<br/>NetSuite TBA, Asana token,<br/>Entra client secret, HMAC secret")]:::data
    end

    subgraph EXT["Systems of record - Asana is also the case record"]
        direction LR
        MBX["Shared mailbox<br/>PA email only (revenue team BCC'd)<br/>MS Graph Mail.Read"]:::ext
        SFDC["Salesforce<br/>Quote, Files, Agreements<br/>REST SOQL + file download<br/>client credentials, integration user"]:::ext
        NS["NetSuite<br/>Sales Order, Revenue Arrangement<br/>SuiteQL + REST Record, TBA"]:::ext
        ASANA["Asana<br/>Deal Review Tracker (annual project)<br/>fields: Quote Number, Agent stages,<br/>needs_human"]:::ext
        SHP["SharePoint Finance<br/>customer / New Deals / month<br/>Graph Sites.Selected"]:::ext
    end

    VAI["Vertex AI - Gemini<br/>only if an LLM stage is adopted"]:::opt
    OBS["Cloud Logging + Monitoring<br/>error and needs_human alerts,<br/>per-deal trace"]:::gcp

    PAUT --> GWH
    NSHOOK --> GWH
    SCHED -.->|"OIDC"| ADV
    GWH -->|"OIDC token"| EV

    EV -->|"enqueue"| TASKS
    TASKS -->|"POST /internal/advance (OIDC)"| ADV
    ADV --> ORCH
    ORCH --> STAGES
    STAGES --> CONN
    STAGES -.-> AGENT
    AGENT -.-> VAI

    CONN --> SM

    CONN --> MBX
    CONN --> SFDC
    CONN --> NS
    CONN <--> ASANA
    CONN --> SHP

    CR --> OBS
